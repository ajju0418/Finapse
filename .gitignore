# =============================================================
# Finapse — repository-wide ignore rules
# =============================================================

# --- Build output -------------------------------------------
target/
build/
dist/
out/

# Next.js build output (root-level strays and any nested app)
.next/

# --- Dependencies -------------------------------------------
node_modules/

# --- Environment / secrets ----------------------------------
# Never commit real credentials. Use .env files locally and
# real environment variables in deployed environments.
.env
.env.*
!.env.example

# --- Logs ---------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Editor / OS --------------------------------------------
.DS_Store
Thumbs.db
.idea/
*.iml
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# --- Java / Maven -------------------------------------------
*.class
.mvn/
!.mvn/wrapper/maven-wrapper.properties

# --- Test / scratch output ----------------------------------
*.tsbuildinfo
